 "items": [
  {
   "n": 1,
   "sec": 0,
   "text": "Раз, два, три, четыре, пять.",
   "kind": "test"
  },
  {
   "n": 2,
   "sec": 0,
   "text": "Привет! Я Абибян.",
   "kind": "test"
  },
  {
   "n": 3,
   "sec": 0,
   "text": "Это проверка звука.",
   "kind": "test"
  },
  {
   "n": 4,
   "sec": 1,
   "text": "Привет! Я так скучал!",
   "kind": "line"
  },
  {
   "n": 5,
   "sec": 1,
   "text": "О, ты вернулся!",
   "kind": "line"
  },
  {
   "n": 6,
   "sec": 1,
   "text": "Ура, гости!",
   "kind": "line"
  },
  {
   "n": 7,
   "sec": 1,
   "text": "Агу! Ты пришёл!",
   "kind": "line"
  },
  {
   "n": 8,
   "sec": 1,
   "text": "Абибя-а-ан!",
   "kind": "line"
  },
  {
   "n": 9,
   "sec": 1,
   "text": "Обними меня!",
   "kind": "line"
  },
  {
   "n": 10,
   "sec": 1,
   "text": "Агу!",
   "kind": "line"
  },
  {
   "n": 11,
   "sec": 1,
   "text": "Гу-гу!",
   "kind": "line"
  },
  {
   "n": 12,
   "sec": 1,
   "text": "Хочу молочка!",
   "kind": "line"
  },
  {
   "n": 13,
   "sec": 1,
   "text": "Я расту?",
   "kind": "line"
  },
  {
   "n": 14,
   "sec": 1,
   "text": "Ням?",
   "kind": "line"
  },
  {
   "n": 15,
   "sec": 1,
   "text": "Абибя!",
   "kind": "line"
  },
  {
   "n": 16,
   "sec": 1,
   "text": "Поиграй со мной!",
   "kind": "line"
  },
  {
   "n": 17,
   "sec": 2,
   "text": "Я уже большой!",
   "kind": "line"
  },
  {
   "n": 18,
   "sec": 2,
   "text": "Поиграем в лианы?",
   "kind": "line"
  },
  {
   "n": 19,
   "sec": 2,
   "text": "Хочу пюрешку!",
   "kind": "line"
  },
  {
   "n": 20,
   "sec": 2,
   "text": "А что это?",
   "kind": "line"
  },
  {
   "n": 21,
   "sec": 2,
   "text": "Смотри, как я умею!",
   "kind": "line"
  },
  {
   "n": 22,
   "sec": 2,
   "text": "Я почти взрослый!",
   "kind": "line"
  },
  {
   "n": 23,
   "sec": 2,
   "text": "Скучно... шучу!",
   "kind": "line"
  },
  {
   "n": 24,
   "sec": 2,
   "text": "Можно мне шаурму?",
   "kind": "line"
  },
  {
   "n": 25,
   "sec": 2,
   "text": "Сфоткай меня!",
   "kind": "line"
  },
  {
   "n": 26,
   "sec": 2,
   "text": "Я подрос!",
   "kind": "line"
  },
  {
   "n": 27,
   "sec": 2,
   "text": "Смотри, какой я большой!",
   "kind": "line"
  },
  {
   "n": 28,
   "sec": 2,
   "text": "Ура, я вырос!",
   "kind": "line"
  },
  {
   "n": 29,
   "sec": 3,
   "text": "Почеши мне пузико!",
   "kind": "line"
  },
  {
   "n": 30,
   "sec": 3,
   "text": "Пойдём поиграем?",
   "kind": "line"
  },
  {
   "n": 31,
   "sec": 3,
   "text": "Банан бы сейчас...",
   "kind": "line"
  },
  {
   "n": 32,
   "sec": 3,
   "text": "Я пушистый и это прекрасно.",
   "kind": "line"
  },
  {
   "n": 33,
   "sec": 3,
   "text": "Мне нравится наш дом!",
   "kind": "line"
  },
  {
   "n": 34,
   "sec": 3,
   "text": "Скажи что-нибудь в микрофон!",
   "kind": "line"
  },
  {
   "n": 35,
   "sec": 3,
   "text": "Давай поиграем в игру!",
   "kind": "line"
  },
  {
   "n": 36,
   "sec": 3,
   "text": "Погладь меня по голове!",
   "kind": "line"
  },
  {
   "n": 37,
   "sec": 3,
   "text": "Хочу в душ с мыльной пеной!",
   "kind": "line"
  },
  {
   "n": 38,
   "sec": 3,
   "text": "Сорви мне банан с дерева!",
   "kind": "line"
  },
  {
   "n": 39,
   "sec": 3,
   "text": "Пощекочи мне пузико!",
   "kind": "line"
  },
  {
   "n": 40,
   "sec": 4,
   "text": "Я голодный!",
   "kind": "line"
  },
  {
   "n": 41,
   "sec": 4,
   "text": "Пузико урчит...",
   "kind": "line"
  },
  {
   "n": 42,
   "sec": 4,
   "text": "Покорми меня, пожалуйста!",
   "kind": "line"
  },
  {
   "n": 43,
   "sec": 4,
   "text": "Мне скууучно!",
   "kind": "line"
  },
  {
   "n": 44,
   "sec": 4,
   "text": "Я так устал...",
   "kind": "line"
  },
  {
   "n": 45,
   "sec": 4,
   "text": "Пора спатеньки...",
   "kind": "line"
  },
  {
   "n": 46,
   "sec": 4,
   "text": "Фу, я весь грязный!",
   "kind": "line"
  },
  {
   "n": 47,
   "sec": 4,
   "text": "Помоешь меня?",
   "kind": "line"
  },
  {
   "n": 48,
   "sec": 4,
   "text": "Голова кружится...",
   "kind": "line"
  },
  {
   "n": 49,
   "sec": 4,
   "text": "Ой-ой-ой...",
   "kind": "line"
  },
  {
   "n": 50,
   "sec": 4,
   "text": "Не мешай, я сплю...",
   "kind": "line"
  },
  {
   "n": 51,
   "sec": 4,
   "text": "Хррр... что?",
   "kind": "line"
  },
  {
   "n": 52,
   "sec": 4,
   "text": "Я слишком устал для игр...",
   "kind": "line"
  },
  {
   "n": 53,
   "sec": 4,
   "text": "Дай поспать сначала!",
   "kind": "line"
  },
  {
   "n": 54,
   "sec": 4,
   "text": "Выспался!",
   "kind": "line"
  },
  {
   "n": 55,
   "sec": 4,
   "text": "Доброе утро!",
   "kind": "line"
  },
  {
   "n": 56,
   "sec": 4,
   "text": "Я полон сил!",
   "kind": "line"
  },
  {
   "n": 57,
   "sec": 4,
   "text": "Ну вот, разбудили...",
   "kind": "line"
  },
  {
   "n": 58,
   "sec": 5,
   "text": "Хочу молочко!",
   "kind": "line"
  },
  {
   "n": 59,
   "sec": 5,
   "text": "Хочу фруктовое пюре!",
   "kind": "line"
  },
  {
   "n": 60,
   "sec": 5,
   "text": "Хочу банан!",
   "kind": "line"
  },
  {
   "n": 61,
   "sec": 5,
   "text": "Хочу яблоко!",
   "kind": "line"
  },
  {
   "n": 62,
   "sec": 5,
   "text": "Хочу салат!",
   "kind": "line"
  },
  {
   "n": 63,
   "sec": 5,
   "text": "Хочу кашу!",
   "kind": "line"
  },
  {
   "n": 64,
   "sec": 5,
   "text": "Хочу арбуз!",
   "kind": "line"
  },
  {
   "n": 65,
   "sec": 5,
   "text": "Хочу кофе!",
   "kind": "line"
  },
  {
   "n": 66,
   "sec": 5,
   "text": "Хочу мороженое!",
   "kind": "line"
  },
  {
   "n": 67,
   "sec": 5,
   "text": "Хочу квас!",
   "kind": "line"
  },
  {
   "n": 68,
   "sec": 5,
   "text": "Хочу доширак!",
   "kind": "line"
  },
  {
   "n": 69,
   "sec": 5,
   "text": "Хочу пельмени!",
   "kind": "line"
  },
  {
   "n": 70,
   "sec": 5,
   "text": "Хочу шаурму!",
   "kind": "line"
  },
  {
   "n": 71,
   "sec": 5,
   "text": "Хочу бургер!",
   "kind": "line"
  },
  {
   "n": 72,
   "sec": 5,
   "text": "Хочу торт!",
   "kind": "line"
  },
  {
   "n": 73,
   "sec": 5,
   "text": "Хочу энергетик!",
   "kind": "line"
  },
  {
   "n": 74,
   "sec": 5,
   "text": "Хочу диет-чай!",
   "kind": "line"
  },
  {
   "n": 75,
   "sec": 5,
   "text": "Хочу зелье радости!",
   "kind": "line"
  },
  {
   "n": 76,
   "sec": 5,
   "text": "Хочу кое-что!",
   "kind": "line"
  },
  {
   "n": 77,
   "sec": 5,
   "text": "Мне такое ещё рано!",
   "kind": "line"
  },
  {
   "n": 78,
   "sec": 5,
   "text": "Ням-ням!",
   "kind": "line"
  },
  {
   "n": 79,
   "sec": 5,
   "text": "Вкуснятина!",
   "kind": "line"
  },
  {
   "n": 80,
   "sec": 5,
   "text": "Ещё!",
   "kind": "line"
  },
  {
   "n": 81,
   "sec": 5,
   "text": "Объедение!",
   "kind": "line"
  },
  {
   "n": 82,
   "sec": 5,
   "text": "Ой, я лопну!",
   "kind": "line"
  },
  {
   "n": 83,
   "sec": 5,
   "text": "Больше не влезет... но давай!",
   "kind": "line"
  },
  {
   "n": 84,
   "sec": 5,
   "text": "Буэ... то есть спасибо!",
   "kind": "line"
  },
  {
   "n": 85,
   "sec": 5,
   "text": "Фу, салат...",
   "kind": "line"
  },
  {
   "n": 86,
   "sec": 5,
   "text": "Ну ладно, ради фигуры.",
   "kind": "line"
  },
  {
   "n": 87,
   "sec": 5,
   "text": "Бодрячком!",
   "kind": "line"
  },
  {
   "n": 88,
   "sec": 5,
   "text": "Вжух! Я заряжен!",
   "kind": "line"
  },
  {
   "n": 89,
   "sec": 5,
   "text": "Чувствую лёгкость!",
   "kind": "line"
  },
  {
   "n": 90,
   "sec": 6,
   "text": "Хи-хи-хи!",
   "kind": "line"
  },
  {
   "n": 91,
   "sec": 6,
   "text": "Щекотно!",
   "kind": "line"
  },
  {
   "n": 92,
   "sec": 6,
   "text": "Ха-ха, перестань!",
   "kind": "line"
  },
  {
   "n": 93,
   "sec": 6,
   "text": "Мур... то есть ух-ух!",
   "kind": "line"
  },
  {
   "n": 94,
   "sec": 6,
   "text": "Приятно!",
   "kind": "line"
  },
  {
   "n": 95,
   "sec": 6,
   "text": "Ещё погладь!",
   "kind": "line"
  },
  {
   "n": 96,
   "sec": 6,
   "text": "Буп!",
   "kind": "line"
  },
  {
   "n": 97,
   "sec": 6,
   "text": "Мой нос!",
   "kind": "line"
  },
  {
   "n": 98,
   "sec": 6,
   "text": "Пип!",
   "kind": "line"
  },
  {
   "n": 99,
   "sec": 6,
   "text": "Красавчик!",
   "kind": "line"
  },
  {
   "n": 100,
   "sec": 6,
   "text": "Ну я и пушистик!",
   "kind": "line"
  },
  {
   "n": 101,
   "sec": 6,
   "text": "Какой я милашка!",
   "kind": "line"
  },
  {
   "n": 102,
   "sec": 6,
   "text": "Какой стройный!",
   "kind": "line"
  },
  {
   "n": 103,
   "sec": 6,
   "text": "Свежий банан!",
   "kind": "line"
  },
  {
   "n": 104,
   "sec": 6,
   "text": "Прямо с ветки!",
   "kind": "line"
  },
  {
   "n": 105,
   "sec": 6,
   "text": "Урожай!",
   "kind": "line"
  },
  {
   "n": 106,
   "sec": 6,
   "text": "Ля-ля-ля!",
   "kind": "line"
  },
  {
   "n": 107,
   "sec": 6,
   "text": "Тёпленькая!",
   "kind": "line"
  },
  {
   "n": 108,
   "sec": 6,
   "text": "Буль-буль!",
   "kind": "line"
  },
  {
   "n": 109,
   "sec": 6,
   "text": "Чистенький!",
   "kind": "line"
  },
  {
   "n": 110,
   "sec": 6,
   "text": "Свежесть!",
   "kind": "line"
  },
  {
   "n": 111,
   "sec": 6,
   "text": "Блестю!",
   "kind": "line"
  },
  {
   "n": 112,
   "sec": 6,
   "text": "Сначала намыль меня!",
   "kind": "line"
  },
  {
   "n": 113,
   "sec": 6,
   "text": "Спасибо!",
   "kind": "line"
  },
  {
   "n": 114,
   "sec": 6,
   "text": "Ура, ты лучший!",
   "kind": "line"
  },
  {
   "n": 115,
   "sec": 6,
   "text": "Обожаю тебя!",
   "kind": "line"
  },
  {
   "n": 116,
   "sec": 6,
   "text": "Ура! Я Абибян!",
   "kind": "line"
  },
  {
   "n": 117,
   "sec": 7,
   "text": "Эх, сейчас бы на диванчик...",
   "kind": "line"
  },
  {
   "n": 118,
   "sec": 7,
   "text": "Где мой пульт?",
   "kind": "line"
  },
  {
   "n": 119,
   "sec": 7,
   "text": "Раньше бананы были слаще.",
   "kind": "line"
  },
  {
   "n": 120,
   "sec": 7,
   "text": "Я не толстый, я пушистый!",
   "kind": "line"
  },
  {
   "n": 121,
   "sec": 7,
   "text": "Пузо — мозоль от счастья.",
   "kind": "line"
  },
  {
   "n": 122,
   "sec": 7,
   "text": "Шаурмы бы...",
   "kind": "line"
  },
  {
   "n": 123,
   "sec": 7,
   "text": "Опять эти ваши зарядки...",
   "kind": "line"
  },
  {
   "n": 124,
   "sec": 7,
   "text": "Солидный мужчина.",
   "kind": "line"
  },
  {
   "n": 125,
   "sec": 7,
   "text": "Мангал — это святое.",
   "kind": "line"
  },
  {
   "n": 126,
   "sec": 7,
   "text": "Шашлычок бы...",
   "kind": "line"
  },
  {
   "n": 127,
   "sec": 7,
   "text": "Я стал настоящим скуфом!",
   "kind": "line"
  },
  {
   "n": 128,
   "sec": 7,
   "text": "Кажется, я поправился...",
   "kind": "line"
  },
  {
   "n": 129,
   "sec": 7,
   "text": "Я похудел!",
   "kind": "line"
  },
  {
   "n": 130,
   "sec": 8,
   "text": "Привет!",
   "kind": "phrases"
  },
  {
   "n": 131,
   "sec": 8,
   "text": "Привет, Абибян!",
   "kind": "phrases"
  },
  {
   "n": 132,
   "sec": 8,
   "text": "Абибян!",
   "kind": "phrases"
  },
  {
   "n": 133,
   "sec": 8,
   "text": "Как дела?",
   "kind": "phrases"
  },
  {
   "n": 134,
   "sec": 8,
   "text": "Привет, как дела?",
   "kind": "phrases"
  },
  {
   "n": 135,
   "sec": 8,
   "text": "Я тебя люблю!",
   "kind": "phrases"
  },
  {
   "n": 136,
   "sec": 8,
   "text": "Абибян, я тебя люблю!",
   "kind": "phrases"
  },
  {
   "n": 137,
   "sec": 8,
   "text": "Ты хороший!",
   "kind": "phrases"
  },
  {
   "n": 138,
   "sec": 8,
   "text": "Ты милый!",
   "kind": "phrases"
  },
  {
   "n": 139,
   "sec": 8,
   "text": "Ты лучший!",
   "kind": "phrases"
  },
  {
   "n": 140,
   "sec": 8,
   "text": "Ты смешной!",
   "kind": "phrases"
  },
  {
   "n": 141,
   "sec": 8,
   "text": "Абибян хороший!",
   "kind": "phrases"
  },
  {
   "n": 142,
   "sec": 8,
   "text": "Спокойной ночи!",
   "kind": "phrases"
  },
  {
   "n": 143,
   "sec": 8,
   "text": "Пока!",
   "kind": "phrases"
  },
  {
   "n": 144,
   "sec": 8,
   "text": "Пока-пока!",
   "kind": "phrases"
  },
  {
   "n": 145,
   "sec": 8,
   "text": "Как тебя зовут?",
   "kind": "phrases"
  },
  {
   "n": 146,
   "sec": 8,
   "text": "Меня зовут Абибян!",
   "kind": "phrases"
  },
  {
   "n": 147,
   "sec": 8,
   "text": "Ты кто?",
   "kind": "phrases"
  },
  {
   "n": 148,
   "sec": 8,
   "text": "Что делаешь?",
   "kind": "phrases"
  },
  {
   "n": 149,
   "sec": 8,
   "text": "Ты голодный?",
   "kind": "phrases"
  },
  {
   "n": 150,
   "sec": 8,
   "text": "Хочешь банан?",
   "kind": "phrases"
  },
  {
   "n": 151,
   "sec": 8,
   "text": "Давай играть!",
   "kind": "phrases"
  },
  {
   "n": 152,
